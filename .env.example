# Postgres connection string (Neon or Supabase, pooled connection)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-64-hex-chars"

# Your login credentials
OWNER_USERNAME="me"
# bcrypt hash of your password. Generate with:
#   node scripts/hash-password.mjs "your-password-here"
OWNER_PASSWORD_HASH="$2b$12$replace.me.with.a.real.bcrypt.hash"

# Defaults for a fresh account
DEFAULT_CURRENCY="MYR"
DEFAULT_LOCALE="Asia/Kuala_Lumpur"
DEFAULT_MONTHLY_BUDGET="2000"
