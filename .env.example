# Postgres connection string (Neon or Supabase, pooled connection)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-64-hex-chars"

# Your login credentials
OWNER_USERNAME="me"
# bcrypt hash of your password. Generate with:
#   node scripts/hash-password.mjs "your-password-here"
OWNER_PASSWORD_HASH="$2b$12$replace.me.with.a.real.bcrypt.hash"

# Defaults for a fresh account
DEFAULT_CURRENCY="MYR"
DEFAULT_LOCALE="Asia/Kuala_Lumpur"
DEFAULT_MONTHLY_BUDGET="2000"

# ── Email accounts ──────────────────────────────────────────────────────────
# Signup and login work without these. They are only needed for the app to
# SEND verification and password-reset emails; without them the links are
# printed to the server log instead.
#
# Sign up at resend.com, verify a sending domain, then set both:
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Coffer <noreply@yourdomain.com>"

# Base URL used in emailed links. Vercel sets this automatically; override only
# if you use a custom domain.
# APP_URL="https://your-app.vercel.app"

# Protects the nightly demo-reset cron. Required in production.
CRON_SECRET="generate-a-long-random-string"
